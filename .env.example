# RadInsights - Environment variables template
# Copy to .env and fill in. Do not commit .env or .env.local
#
# Load order: .env (base) -> .env.local (local overrides) -> .env.production (when ENV=production)
# Use .env.local for local-only settings (gitignored).

# Required - generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Local development: force SQLite (faster startup, no Neon connection)
# Add to .env.local: USE_LOCAL_DB=1
# USE_LOCAL_DB=1

# Local + Neon: if you get "postgres message too large", use pooled URL
# Add to .env.local: USE_POOLED_DB=1 and ensure DATABASE_URL (pooled) is set
# USE_POOLED_DB=1

# Production: Vercel/Neon sets DATABASE_URL or frcr_revision_db_* automatically

# Reference Image Curation (Google Custom Search - CC-licensed images)
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_ENGINE_ID=

# Reference Image Search (multi-provider)
# Default: commons,openi (free, no API keys). Add google when CSE works.
# REFERENCE_IMAGE_SEARCH_PROVIDERS=commons,openi
# Optional: Bing Image Search (Azure) - add 'bing' to providers above
# BING_IMAGE_SEARCH_KEY=

# Case DICOM Viewer (OneDrive image stacks)
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# APP_URL=https://yourapp.vercel.app

# R2 upload limit (MB). Default 1024. Increase for very large stacks (1000+ images).
# MAX_UPLOAD_MB=1024

# Cloudflare R2 (case image stack storage - optional, for R2 migration)
# Add to .env (not .env.local). Create bucket at Cloudflare Dashboard > R2
# API Tokens: R2 > Manage R2 API Tokens (use Access Key ID + Secret Access Key, not Token value)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_JURISDICTION=eu   # Only if bucket is in EU jurisdiction (omit for US/default)
# R2_UPLOAD_WORKERS=20 # Parallel upload threads (default 20, max 32)
