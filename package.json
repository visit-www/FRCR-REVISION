{
  "name": "frcr-examiner",
  "version": "1.0.0",
  "description": "FRCR Examiner - Desktop Application with Local Data Storage",
  "main": "electron/main.js",
  "homepage": "./",
  "author": "FRCR Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run start-backend\" \"sleep 2 && electron .\"",
    "start-backend": "python -m flask run --port=5000",
    "build": "electron-builder",
    "build-mac": "electron-builder --mac",
    "build-win": "electron-builder --win",
    "build-all": "electron-builder -mw",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "concurrently": "^8.2.2"
  },
  "build": {
    "appId": "com.frcr.examiner",
    "productName": "FRCR Examiner",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "instance/**/*",
      "backups/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.medical",
      "icon": "assets/icon.icns"
    },
    "dmg": {
      "contents": [
        {
          "x": 110,
          "y": 150,
          "type": "file"
        },
        {
          "x": 240,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
